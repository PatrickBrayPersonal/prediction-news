{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "UPDATE FEED",
            "type": "debugpy",
            "request": "launch",
            "program": "scripts/update_feed.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "elon ticker",
            "type": "debugpy",
            "request": "launch",
            "program": "scripts/update_feed.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "args": ["--ticker", "KXELONMARS-99"]
        },
        {
            "name": "anthropic ipo ticker",
            "type": "debugpy",
            "request": "launch",
            "program": "scripts/update_feed.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "args": ["--ticker", "KXOAIANTH-40-OAI"]
        },
        {
            "name": "pope build",
            "type": "debugpy",
            "request": "launch",
            "program": "scripts/build_erdo_pope.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        }
    ]
}